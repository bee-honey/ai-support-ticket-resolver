# OpenAI credentials
OPENAI_API_KEY=sk-changeme

# Model configuration
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Model used by the eval framework's LLM judges and query generator (evals/)
JUDGE_MODEL=gpt-4o-mini
# Models offered in the UI model pickers (comma-separated)
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1

# ChromaDB
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=support_tickets

# Chunking defaults (see app/config/settings.py)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Retrieval defaults
DEFAULT_TOP_K=5
